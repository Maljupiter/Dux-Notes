# Server-only secret. Add this in Vercel Project Settings, not in frontend code.
GROQ_API_KEY=your_groq_api_key_here

# Optional Groq text and vision models for the Vercel backend.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_FALLBACK_MODEL=

# Frontend only. Use this when building the Mac desktop app so it knows your Vercel backend URL.
# Example: VITE_DUX_AI_API_URL=https://your-project.vercel.app/api/dux-ai
VITE_DUX_AI_API_URL=
