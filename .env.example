# Server-only secret. Add this in Vercel Project Settings, not in frontend code.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional Gemini model for the Vercel backend.
GEMINI_MODEL=gemini-2.5-flash

# Frontend only. Use this when building the Mac desktop app so it knows your Vercel backend URL.
# Example: VITE_DUX_AI_API_URL=https://your-project.vercel.app/api/dux-ai
VITE_DUX_AI_API_URL=
